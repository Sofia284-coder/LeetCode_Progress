class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:

        #sliding window comes to my mind
        #we start and then keep count of those we have visited so far, if any repeats then we forget the previous and start again and also keep count of the previous length

        #Mistake in thinking: we don't discard the previous, we only disard the one that was duplicate(adjusting left window)

        if len(s) == 0:
            return 0

        sub_string = [s[0]]

        sub_strings_set = {s[0]}

        master = [1]

        count = 1

        for i in range(1, len(s)):

            if s[i] in sub_strings_set:
                master.append(count)
                index = sub_string.index(s[i])
                sub_string = sub_string[index + 1:]
                sub_string.append(s[i])
                count = len(sub_string)
                sub_strings_set = set(sub_string)

            else:
                sub_string.append(s[i])
                sub_strings_set.add(s[i])
                count = count + 1

        master.append(count)

        return max(master)
